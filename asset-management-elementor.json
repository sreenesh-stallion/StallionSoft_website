            {
              "id": "w_hero_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Complete Lifecycle Visibility with <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#0f52ba] to-[#00b4d8]\">Asset Management.</span>",
                "header_size": "h1",
                "_css_classes": "font-headline text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#001945] tracking-tight leading-tight mt-3"
              }
