              "id": "w_hero_badge",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200/60\"><span class=\"w-2 h-2 rounded-full bg-[#003c90] animate-pulse\"></span><span class=\"text-xs font-bold uppercase tracking-wider text-[#003c90] font-mono-tech\">Enterprise Asset Intelligence</span></div>"
